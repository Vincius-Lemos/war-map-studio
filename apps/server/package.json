{
  "name": "@map-draw/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Fastify do MAP-DRAW: serve o site, os dados geográficos, as cenas e a exportação de vídeo",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
